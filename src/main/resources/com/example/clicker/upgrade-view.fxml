<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="600.0" prefWidth="500.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.clicker.UpgradeController">
   <children>
      <Label fx:id="lblTitle" layoutX="102.0" layoutY="31.0" text="Upgrade" textFill="WHITE">
         <font>
            <Font name="System Bold" size="73.0" />
         </font>
      </Label>
      <Button fx:id="btnAutoUpgrade" layoutX="28.0" layoutY="191.0" mnemonicParsing="false" onAction="#onAutoUpgrade" prefHeight="56.0" prefWidth="246.0" text="Auto Upgrade" textFill="WHITE">
         <font>
            <Font size="26.0" />
         </font>
      </Button>
      <Button fx:id="btnUpgrade" layoutX="52.0" layoutY="272.0" mnemonicParsing="false" onAction="#onUpgrade" prefHeight="56.0" prefWidth="198.0" text="Upgrade" textFill="WHITE">
         <font>
            <Font size="26.0" />
         </font>
      </Button>
      <Label fx:id="lblAutoUpgrade" layoutX="319.0" layoutY="195.0" text="0" textFill="WHITE">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Label>
      <Label fx:id="lblUpgrade" layoutX="319.0" layoutY="276.0" text="0" textFill="WHITE">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Label>
      <Button fx:id="btnBack" layoutX="180.0" layoutY="531.0" mnemonicParsing="false" onAction="#onButtonBack" prefHeight="46.0" prefWidth="140.0" text="Back" textFill="WHITE">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
