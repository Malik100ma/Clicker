<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="500.0" fx:id="root" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.clicker.MenuController">
   <children>
      <Label layoutX="87.0" layoutY="14.0" fx:id="title" text="Clicker" textFill="WHITE">
         <font>
            <Font name="System Bold" size="96.0" />
         </font>
      </Label>
      <Button fx:id="btnGame" layoutX="160.0" layoutY="163.0" mnemonicParsing="false" onAction="#onButtonToGame" text="To game" textFill="WHITE">
         <font>
            <Font name="System Bold" size="33.0" />
         </font>
      </Button>
      <Button fx:id="btnSettings" layoutX="160.0" layoutY="275.0" mnemonicParsing="false" onAction="#onButtonSettings" prefHeight="72.0" prefWidth="180.0" text="Settings" textFill="WHITE">
         <font>
            <Font name="System Bold" size="33.0" />
         </font>
      </Button>
      <Button fx:id="btnQuit" layoutX="160.0" layoutY="384.0" mnemonicParsing="false" onAction="#onButtonQuit" prefHeight="72.0" prefWidth="180.0" text="Quit" textFill="WHITE">
         <font>
            <Font name="System Bold" size="33.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
