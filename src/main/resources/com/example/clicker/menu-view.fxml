<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="600.0" prefWidth="500.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.clicker.MenuController">
   <children>
      <Label layoutX="87.0" layoutY="14.0" text="Clicker" textFill="WHITE">
         <font>
            <Font name="System Bold" size="96.0" />
         </font>
      </Label>
      <Button id="btnGame" onAction="#onButtonToGame" layoutX="160.0" layoutY="163.0" mnemonicParsing="false" text="To game" textFill="WHITE">
         <font>
            <Font name="System Bold" size="33.0" />
         </font>
      </Button>
      <Button id="btnSettings" onAction="#onButtonSettings" layoutX="160.0" layoutY="275.0" mnemonicParsing="false" prefHeight="72.0" prefWidth="180.0" text="Settings" textFill="WHITE">
         <font>
            <Font name="System Bold" size="33.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
